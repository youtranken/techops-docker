# =============================================================================
#  HƯỚNG DẪN: Copy file này thành .env rồi điền giá trị thật
#  KHÔNG BAO GIỜ commit file .env lên GitHub
# =============================================================================

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Postgres credentials (docker-compose dùng các biến này để khởi tạo DB)
POSTGRES_USER="techops"
POSTGRES_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD"
POSTGRES_DB="techops_db"

# Connection URL cho Prisma (Docker: dùng service name 'db', Local: localhost)
DATABASE_URL="postgresql://techops:CHANGE_ME_TO_STRONG_PASSWORD@db:5432/techops_db"

# ── AUTH ─────────────────────────────────────────────────────────────────────
# BẮT BUỘC: Tạo bằng `openssl rand -base64 32`
AUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"
# Đổi thành IP hoặc domain thật của máy chủ
AUTH_URL="http://localhost:3000"

# ── ADMIN SEED ───────────────────────────────────────────────────────────────
# Mật khẩu admin lần đầu khi seed DB. PHẢI đổi sau lần login đầu.
ADMIN_INITIAL_PASSWORD="ChangeMe@FirstLogin123"

# ── SMTP ENCRYPTION ──────────────────────────────────────────────────────────
# BẮT BUỘC ở production: tạo bằng `openssl rand -base64 32`
# Dùng để mã hóa SMTP password lưu trong DB. Thiếu key này ở production sẽ throw lỗi start.
SMTP_ENCRYPT_KEY="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"

# ── TIMEZONE ─────────────────────────────────────────────────────────────────
TZ="Asia/Bangkok"

# ── FILE UPLOAD ──────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ── REDIS ────────────────────────────────────────────────────────────────────
# Giữ nguyên nếu dùng Redis từ docker-compose
REDIS_URL="redis://redis:6379"

# ── EMAIL (Fallback — có thể cấu hình qua UI: Settings → SMTP) ───────────────
# Nếu đã cấu hình qua UI thì các biến này bị bỏ qua
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-gmail@gmail.com"
# Gmail: tạo App Password tại https://myaccount.google.com/apppasswords
EMAIL_PASS="xxxx-xxxx-xxxx-xxxx"
EMAIL_FROM="TechOps <your-gmail@gmail.com>"

# ── HELPDESK API ─────────────────────────────────────────────────────────────
# API endpoint lấy ticket từ hệ thống Helpdesk nội bộ
HELPDESK_API_URL="https://helpdesk.yourcompany.com/api/tickets"
# Bearer token xác thực với Helpdesk API
HELPDESK_BEARER_TOKEN="your-bearer-token-here"
HELPDESK_SYNC_ENABLED=true

# ── CRON JOBS ────────────────────────────────────────────────────────────────
# Nhắc deadline: chạy mỗi ngày 8:00 AM
CRON_DEADLINE_REMINDER_ENABLED=true
CRON_DEADLINE_REMINDER_DAYS_BEFORE=3
# Auto-sync Helpdesk: lịch cụ thể cấu hình qua UI Settings → Helpdesk
CRON_HELPDESK_SYNC_ENABLED=true
# Password expiry check: daily 9 AM, gửi email nhắc 3 ngày trước hết hạn + buộc đổi nếu hết hạn
# Chính sách "expiryDays" cấu hình tại Settings → Bảo mật (0 = không hết hạn)
CRON_PASSWORD_EXPIRY_ENABLED=true

# ── LOG ARCHIVE ────────────────────────────────────────────────────────────────
# Archive log ra file Excel mỗi tháng (ngày 1, lúc 01:00), xóa log > 90 ngày khỏi DB
# Để trống = tắt tính năng archive
LOG_ARCHIVE_PATH=/app/logs


# ── SENTRY (tuỳ chọn — bỏ qua nếu không dùng) ───────────────────────────────
# Đăng ký tại https://sentry.io để có DSN
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
