# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Next.js ──────────────────────────────────────────────────────────────────
.next/
out/
build/

# ─── Environment (KHÔNG bao giờ commit file này lên Git!) ─────────────────────
.env
.env.local
.env.*.local

# ─── Uploads (file của user, không commit) ────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Prisma ───────────────────────────────────────────────────────────────────
prisma/dev.db
prisma/test.db

# ─── Build artifacts ─────────────────────────────────────────────────────────
tsconfig.tsbuildinfo

# ─── DB backups (chứa data nhạy cảm — KHÔNG commit) ─────────────────────────
backups/
*.dump
*.sql.gz

# ─── Editor / AI tools ───────────────────────────────────────────────────────
.claude/

# Playwright output
e2e/.results/

# Dữ liệu chạy thật trên máy chạy app (không đưa lên git)
/uploads/
/logs/
/backups/
